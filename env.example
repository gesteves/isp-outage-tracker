# Connectivity Check Configuration (Optional - defaults shown)
# Invalid values fall back to the defaults.
NEXT_PUBLIC_CHECK_INTERVAL_SECONDS=60  # minimum 5
NEXT_PUBLIC_FAILURE_THRESHOLD=2        # minimum 1

# Emoji shower when an outage starts or ends (Optional - defaults shown)
NEXT_PUBLIC_EMOJI_SHOWER_DURATION_MS=3000  # how long emoji keep falling, minimum 100
NEXT_PUBLIC_EMOJI_SHOWER_FALL_MS=2000      # how long each emoji takes to cross the screen, minimum 100
NEXT_PUBLIC_EMOJI_SHOWER_PER_SECOND=15     # emoji that start falling each second, minimum 1
# Emoji written together, or separated by spaces or commas
NEXT_PUBLIC_OUTAGE_START_EMOJI=😩🤬😱💀💩🫪😡😭🥲😨😰🥺🫠😑🫩😵‍💫
NEXT_PUBLIC_OUTAGE_END_EMOJI=😃😄😁🤩😺😸🙌🎉✨
